{
  // ============================================================
  // 公開フィッシングURLの取得元
  // ============================================================
  // OpenPhishは公開テキストフィード，PhishTankはCSVフィードです．
  // 取得できないフィードがあっても，他のフィードやmanual_urls.txtで処理を続けます．
  "feeds": [
    {
      "name": "openphish",
      "enabled": true,
      "url": "https://openphish.com/feed.txt",
      "format": "text"
    },
    {
      "name": "phishtank",
      "enabled": true,
      "url": "https://data.phishtank.com/data/online-valid.csv",
      "format": "csv",
      "url_column": "url"
    }
  ],

  // ============================================================
  // 手動URL
  // ============================================================
  // フィードとは別に，自分で観察したいURLを書くファイルです．
  // 1行に1URLを書きます．#で始まる行は無視されます．
  "manual_urls_path": "phishing_capture/manual_urls.txt",

  // ============================================================
  // 観察件数
  // ============================================================
  // 1回の実行でreview.csvに残す最大件数です．
  // 200〜399で応答し，スクリーンショット取得に成功したものだけを対象にします．
  "max_urls": 500,

  // 発表用候補を集めるために，公開DBから最大で何件まで確認するかです．
  // 日本企業など対象が限定されるブランドでは，max_urlsより大きめにします．
  "max_checked_urls": 10000,

  // ============================================================
  // 出力
  // ============================================================
  // 実行ごとに日時付きサブフォルダを作ります．
  "output_dir": "reports/phishing_observation",

  // ============================================================
  // ページ取得
  // ============================================================
  // 1サイトあたりの最大待ち時間です．
  "timeout_seconds": 6,

  // DOM読み込み後に追加で待つ時間です．
  // JavaScriptによって描画されるページ向けです．
  "wait_after_load_ms": 2500,

  // trueの場合，通信が落ち着くのを待ってからスクリーンショットを撮ります．
  // 広告や解析タグなどで完全に静止しない場合でも，失敗時は処理を続けます．
  "wait_until_network_idle": true,

  // bodyのテキストが一定時間変化しないことを確認してから撮影します．
  // 真っ白なスクリーンショットを減らすための設定です．
  "wait_for_stable_body_ms": 1200,

  // JavaScriptを有効にします．
  // クリック，文字入力，ファイルダウンロードなどは行いません．
  "javascript_enabled": true,

  // HTML本文を保存するかどうかです．
  // スクリーンショット中心の観察ではfalseで十分です．
  "save_html": false,

  // trueの場合，フィード取得，URL候補確認，サイト観察の進捗バーを表示します．
  "progress": true,

  // trueの場合のみ、reference_sites にある正規サイトのスクリーンショットを保存します。
  // デフォルトでは false にして、発表で比較用に必要なときだけ有効化します。
  "capture_reference_sites": true,

  // ============================================================
  // フィード・HTTPレスポンスの条件
  // ============================================================
  // trueの場合，PhishTankではverified=yesかつonline=yesだけを利用します．
  // OpenPhishには同等の列がないため，そのまま候補として利用します．
  "require_verified_online": true,

  // trueの場合，200〜399で応答し，スクリーンショットを保存できたものだけを
  // review.csvに残します．それ以外はrejected.csvに保存します．
  "require_http_success": true,

  // trueの場合，reference_sitesに登録された正規サイトそのものは除外します．
  "exclude_reference_hosts": true,

  // ============================================================
  // 探索対象
